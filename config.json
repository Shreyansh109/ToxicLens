{
  "random_seed": 42,
  "paths": {
    "raw_data": "data/raw",
    "processed_data": "data/processed",
    "models": "models"
  },
  "data_split": {
    "train_size": 0.8,
    "validation_size": 0.1,
    "test_size": 0.1
  },
  "labels": ["toxic", "severe_toxic", "obscene", "threat", "insult", "identity_hate"],
  "tfidf": {
    "max_features": 50000,
    "ngram_range": [1, 2],
    "min_df": 2
  },
    "logistic_regression": {
    "C": 1.0,
    "max_iter": 1000,
    "class_weight": null
  },
  "prediction": {
    "threshold": 0.5,
    "label_thresholds": {
      "toxic": 0.30,
      "severe_toxic": 0.16,
      "obscene": 0.18,
      "threat": 0.05,
      "insult": 0.21,
      "identity_hate": 0.20
    },
    "review_band": [0.3, 0.7]
  }
}