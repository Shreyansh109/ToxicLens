{
  "random_seed": 42,
  "paths": {
    "raw_data": "data/raw",
    "processed_data": "data/processed",
    "models": "models"
  },
  "data_split": {
    "train_size": 0.8,
    "validation_size": 0.1,
    "test_size": 0.1
  },
  "labels": ["toxic", "severe_toxic", "obscene", "threat", "insult", "identity_hate"],
  "tfidf": {
    "max_features": 50000,
    "ngram_range": [1, 2],
    "min_df": 2
  },
  "logistic_regression": {
    "C": 1.0,
    "max_iter": 1000,
    "class_weight": "balanced"
  },
  "prediction": {
    "threshold": 0.5,
    "label_thresholds": {
      "toxic": 0.69,
      "severe_toxic": 0.96,
      "obscene": 0.73,
      "threat": 0.50,
      "insult": 0.76,
      "identity_hate": 0.96
    },
    "review_margin": 0.15,
    "review_all_threats": true
  },
  "transformer": {
    "model_name": "distilbert-base-uncased",
    "max_length": 128,
    "batch_size": 16,
    "learning_rate": 0.00002,
    "epochs": 2,
    "pos_weight_power": 0.5,
    "use_fp16": false
  },
  "prediction_transformer": {
    "threshold": 0.5,
    "label_thresholds": {
      "toxic": 0.81,
      "severe_toxic": 0.81,
      "obscene": 0.83,
      "threat": 0.10,
      "insult": 0.72,
      "identity_hate": 0.86
    },
    "review_margin": 0.15,
    "review_all_threats": true
  }
}